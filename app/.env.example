# Cloudflare Turnstile (captcha) — https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys for local development:
#   site key:   1x00000000000000000000AA (always passes)
#   secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (email delivery) — https://resend.com/api-keys
RESEND_API_KEY=

# Quote request routing
# QUOTE_FROM_EMAIL must be a verified sender/domain in Resend.
QUOTE_TO_EMAIL=kredicoes@gmail.com
QUOTE_FROM_EMAIL="KR Editorial <site@kreditorial.com.br>"
